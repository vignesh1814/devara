int m[3][4]
prati i 0 nundi 3 varaku { prati j 0 nundi 4 varaku { m[i][j] lo i * 10 + j pettu } }
prati i 0 nundi 3 varaku { prati j 0 nundi 4 varaku { m[i][j] ni chupi } }
int tr charya (int x[], int n) {
    int s
    s lo 0 pettu
    prati i 0 nundi n varaku { s lo s + x[i] pettu }
    s ivvu
}
tr(m[0], 4) ni chupi
tr(m[1], 4) ni chupi
tr(m[2], 4) ni chupi
