# ID: DSA-102
# Category: graphs
# Algorithm: counting islands and largest island with recursive flood fill on a grid
# Exercises: 2-D grid input, 4-neighbour recursion with bounds checks, in-place marking, int-returning recursion, global grid
# Difficulty: medium
# Expected: number of islands and size of the largest one
int g[8][8]
int rows
int cols

int fill charya (int r, int c) {
    r < 0 || c < 0 || r >= rows || c >= cols ayite { 0 ivvu }
    g[r][c] != 1 ayite { 0 ivvu }
    g[r][c] lo 2 pettu
    1 + fill(r + 1, c) + fill(r - 1, c) + fill(r, c + 1) + fill(r, c - 1) ivvu
}

rows ni chaduvu
cols ni chaduvu
prati i 0 nundi rows varaku {
    prati j 0 nundi cols varaku { g[i][j] ni chaduvu }
}
int islands
int largest
islands lo 0 pettu
largest lo 0 pettu
prati i 0 nundi rows varaku {
    prati j 0 nundi cols varaku {
        g[i][j] == 1 ayite {
            int s
            s lo fill(i, j) pettu
            islands lo islands + 1 pettu
            s > largest ayite { largest lo s pettu }
        }
    }
}
islands ni chupi
largest ni chupi
