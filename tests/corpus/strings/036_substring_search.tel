# ID: DSA-036
# Category: strings
# Algorithm: naive substring search (all occurrences)
# Exercises: nested loops, bool flag with aapu, padham equality of single chars, two padham inputs, counting
# Difficulty: medium
# Expected: count of occurrences then each start index
padham text
padham pat
text ni chaduvu
pat ni chaduvu
int n
int m
int hits
n lo podavu(text) pettu
m lo podavu(pat) pettu
hits lo 0 pettu
prati i 0 nundi n - m + 1 varaku {
    bool ok
    ok lo nijam pettu
    prati j 0 nundi m varaku {
        text[i + j] != pat[j] ayite {
            ok lo abaddham pettu
            aapu
        }
    }
    ok ayite { hits lo hits + 1 pettu }
}
hits ni chupi
prati i 0 nundi n - m + 1 varaku {
    bool ok
    ok lo nijam pettu
    prati j 0 nundi m varaku {
        text[i + j] != pat[j] ayite {
            ok lo abaddham pettu
            aapu
        }
    }
    ok ayite { i ni chupi }
}
