# ID: DSA-104
# Category: misc
# Algorithm: every pratisari init form x every update form, plus while and range loops
# Exercises: tho-modhalu init, assignment init, declaration init, assignment/++x/x++/--x/x-- updates, array-element update targets, float and char loop variables
# Difficulty: medium
# Expected: sums/prints produced by each loop form (see oracle)
int i
int s
s lo 0 pettu
pratisari (i 1 tho modhalu; i <= 5; i lo i + 1 pettu) { s lo s + i pettu }
s ni chupi
s lo 0 pettu
pratisari (i lo 1 pettu; i <= 5; ++i) { s lo s + i pettu }
s ni chupi
s lo 0 pettu
pratisari (int j lo 1 pettu; j <= 5; j++) { s lo s + j pettu }
s ni chupi
s lo 0 pettu
pratisari (i 5 tho modhalu; i >= 1; --i) { s lo s * 10 + i pettu }
s ni chupi
s lo 0 pettu
pratisari (i lo 5 pettu; i >= 1; i--) { s lo s * 10 + i pettu }
s ni chupi
s lo 0 pettu
pratisari (int k lo 0 pettu; k < 10; k lo k + 3 pettu) { s lo s + k pettu }
s ni chupi
int a[4]
a[2] lo 3 pettu
a[3] lo 3 pettu
pratisari (int c lo 0 pettu; a[0] < 5; a[0]++) { c ni chupi }
pratisari (int c lo 0 pettu; a[1] < 3; ++a[1]) { c ni chupi }
pratisari (int c lo 0 pettu; a[2] > 0; a[2]--) { a[2] ni chupi }
pratisari (int c lo 0 pettu; a[3] > 1; --a[3]) { a[3] ni chupi }
a[0] ni chupi
a[1] ni chupi
a[2] ni chupi
a[3] ni chupi
pratisari (float f lo 0.5 pettu; f < 3; f++) { f ni chupi }
pratisari (char ch lo 'a' pettu; ch <= 'e'; ch++) { ch ni chupi }
int n
n lo 3 pettu
n > 0 unnanta varaku { n ni chupi
    n lo n - 1 pettu }
prati r 3 nundi 3 varaku { 999 ni chupi }
prati r 5 nundi 3 varaku { 998 ni chupi }
prati r -2 nundi 2 varaku { r ni chupi }
