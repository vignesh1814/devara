int is_valid charya(int s[], int n) {
    int stack[1000]
    int top
    top lo 0 pettu
    
    int i
    pratisari (i 0 tho modhalu; i < n; i++) {
        s[i] == 40 || s[i] == 91 || s[i] == 123 ayite {
            stack[top] lo s[i] pettu
            top lo top + 1 pettu
        } lekunte {
            top == 0 ayite {
                0 ivvu
            }
            top lo top - 1 pettu
            
            s[i] == 41 && stack[top] != 40 ayite {
                0 ivvu
            }
            s[i] == 93 && stack[top] != 91 ayite {
                0 ivvu
            }
            s[i] == 125 && stack[top] != 123 ayite {
                0 ivvu
            }
        }
    }
    
    top == 0 ayite {
        1 ivvu
    } lekunte {
        0 ivvu
    }
}