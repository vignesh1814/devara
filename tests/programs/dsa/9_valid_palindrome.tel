bool is_palindrome charya(char s[], int n) {
    int left
    left lo 0 pettu
    int right
    right lo n - 1 pettu
    
    left < right unnanta varaku {
        s[left] != s[right] ayite {
            abaddham ivvu
        }
        left lo left + 1 pettu
        right lo right - 1 pettu
    }
    nijam ivvu
}
