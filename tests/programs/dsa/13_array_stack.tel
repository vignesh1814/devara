void init_stack charya(int stack[], int top) {
    top lo 0 pettu
}

void push charya(int stack[], int top, int val) {
    stack[top] lo val pettu
    top lo top + 1 pettu
}

int pop charya(int stack[], int top) {
    top == 0 ayite {
        -1 ivvu
    }
    top lo top - 1 pettu
    stack[top] ivvu
}