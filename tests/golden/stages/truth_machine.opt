global x: i64 scalar

function $entry() -> void {
  entry1:
    t1:i64 = rtcall dv_rt_input_i64()
    store [@x], t1
    t2:i64 = load [@x]
    t3:bool = cmp eq t2, 0
    branch t3, then2, else4
  then2:
    rtcall dv_rt_output_i64(0)
    rtcall dv_rt_shutdown()
    ret
  else4:
    jump wcond5
  wcond5:
    rtcall dv_rt_output_i64(1)
    jump wcond5
}
